# `npx convex dev` mengisi tiga nilai ini otomatis di .env.local
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# Hanya untuk migrasi satu kali dari Supabase (scripts/export-from-supabase.mjs).
# Connection string "Session pooler" dari tombol Connect di dashboard Supabase.
# Hapus setelah migrasi selesai.
SUPABASE_DB_URL=
